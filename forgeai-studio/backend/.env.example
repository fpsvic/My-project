# ForgeAI Studio — backend configuration
#
# Set your Anthropic API key to unlock REAL LLM code generation ("Replit-level"
# coding power). Without it, ForgeAI falls back to its offline template engine.
#
#   export ANTHROPIC_API_KEY=sk-ant-...
#
# Optional: override the model used for code generation (default: claude-opus-4-8)
#   export FORGEAI_LLM_MODEL=claude-opus-4-8

ANTHROPIC_API_KEY=
