[Desktop Entry]
Version=1.0
Type=Application
Name=Blade Arena (Terminal)
GenericName=Play Blade Arena with log output
Comment=Launch Blade Arena in a terminal so you can see errors
Exec=env DISPLAY=:1 WORKSPACE=/workspace xfce4-terminal --title=Blade Arena --hold -e /bin/bash /workspace/scripts/run-blade-arena-desktop.sh
Path=/workspace
Icon=utilities-terminal
Terminal=false
Categories=Game;ActionGame;
StartupNotify=true
