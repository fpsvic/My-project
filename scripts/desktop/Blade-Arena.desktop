[Desktop Entry]
Version=1.0
Type=Application
Name=Blade Arena
GenericName=Play Blade Arena
Comment=Double-click to play Blade Arena on the desktop
Exec=env DISPLAY=:1 WORKSPACE=/workspace /bin/bash /workspace/scripts/run-blade-arena-desktop.sh
Path=/workspace
Icon=applications-games
Terminal=false
Categories=Game;ActionGame;
StartupNotify=true
StartupWMClass=blade_arena
